    "market_refresh_browser": "passed",
    "mixed_venues_and_rolling": "passed",
    "monitor_clock_and_fee_independence": "passed",
    "native_adapter_tests": 116,
    "manager_registration_whitelist_tests": 4,
    "config_save_without_fee_input": "passed",
    "field_error_tests": "passed",
    "manager_delimiter_rewrite": "passed",
    "step_limits_reversal_recovery": "passed"
  },
  "child_port": 18000,
  "supported_venues": [
    "entropy",
    "lighter",
    "rblighter",
    "qfex",
    "decibel",
    "vanta",
    "popdex",
    "arcus"
  ]
